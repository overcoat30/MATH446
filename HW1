def bisect(f, a, b, tol):
    fa = f(a)
    fb = f(b)

    if fa == 0:
        return a
    if fb == 0:
        return b
    if fa * fb > 0:
        raise ValueError("the two intervals must have opposite signs")

    while (b - a) / 2 > tol:
        c = (a + b) / 2
        fc = f(c)

        if fc == 0:
            return c

        if fa * fc < 0:
            b = c
        else:
            a = c
            fa = fc

    return (a + b) / 2


for P in range(500, 1001, 50):
    def f(r):
        return (
            (12 * P / r) * ((1 + r / 12) ** 300 - 1)
            - 1000000
        )

    r = bisect(f, 0.01, 0.20, 1e-12)
    print(f"{P}: {100 * r:.6f}%")
